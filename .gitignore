# Local secrets — JWT, passwords, env-specific overrides
.env
# Everything under secrets/ is ignored, except a single .gitkeep so the
# directory survives `git clone`. Pattern uses /* (not the bare dir) so
# the !.gitkeep re-include actually works — git can't re-include from a
# fully-excluded directory.
secrets/*
!secrets/.gitkeep

# Container data volumes — root-owned, never committed
docker-volume/
compose/docker-volume/

# Generated by scripts/load_clue.sh
clue/data/*.clean.csv

# Misc
*.log
.DS_Store
__pycache__/
*.pyc
DGT Policy Draft v*.docx.md
