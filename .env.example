###############################################################################
# DGT-next environment configuration
#
# Copy to .env and edit as needed:
#   cp .env.example .env
###############################################################################

# --- Compose project name -------------------------------------------------
# Pinned so the project name doesn't drift based on CWD or compose-file order.
COMPOSE_PROJECT_NAME=dgt

# --- OpenMetadata version pin ---------------------------------------------
# Bump this single value to roll OM versions. `make fetch-compose` will
# re-vendor compose/openmetadata.upstream.yml at the new version.
OM_VERSION=1.12.6

# --- Governance Postgres (separate from OM's internal DB) -----------------
GOV_DB_NAME=governance_catalog
GOV_DB_USER=governance_admin
GOV_DB_PASSWORD=governance_admin
GOV_DB_HOST_PORT=5433

# --- OpenMetadata admin (basic auth) --------------------------------------
# Used at first start to provision the admin user. SSO is not configured
# in the MVP; AUTHENTICATION_PROVIDER=basic is the default in upstream compose.
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=admin

# --- Rotated secrets ------------------------------------------------------
# These values get populated by scripts/rotate_secrets.sh. The defaults below
# match the upstream-shipped sample values so a fresh `make up` still works;
# rotate before exposing the stack to anything beyond localhost.
OM_PG_SUPERUSER_PASSWORD=password
OM_DB_USER_PASSWORD=openmetadata_password
AIRFLOW_DB_PASSWORD=airflow_pass
AIRFLOW_ADMIN_PASSWORD=admin

# --- Reverse proxy --------------------------------------------------------
# Caddy fronts both UIs on these ports; self-signed cert until a real domain
# is assigned. Update proxy/Caddyfile to swap in a domain block.
OM_PROXY_PORT=8443
AIRFLOW_PROXY_PORT=8444
